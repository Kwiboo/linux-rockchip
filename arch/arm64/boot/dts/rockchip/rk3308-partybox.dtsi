#include <dt-bindings/input/input.h>
#include "rk3308.dtsi"

/ {
	model = "Rockchip RK3308 PARTYBOX";
	compatible = "rockchip,rk3308-partybox", "rockchip,rk3308";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff0c0000 console=ttyFIQ0 root=PARTUUID=614e0000-0000 rootfstype=squashfs rootwait isolcpus=2,3 nohz_full=2,3 snd_soc_core.prealloc_buffer_size_kbytes=64";
	};

	acodec_sound: acodec-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,rk3308-acodec";
		//rockchip,codec-hp-det;
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&i2s_8ch_2>;
		rockchip,codec = <&acodec>;
		//rockchip,wait-card-locked = <2>;
	};

	amp_dummy_codec: amp-dummy-codec {
		status = "okay";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;

		//enable it when MCLK connected to codec.
		/* clocks = <&cru SCLK_I2S0_8CH_TX_OUT>;
		 * clock-names = "mclk";
		 */
	};

	amp_sound: amp-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-amp";
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&i2s_8ch_0>;
		rockchip,codec = <&amp_dummy_codec>;
	};

	audio_sync0: audio-sync0 {
		status = "okay";
		compatible = "rockchip,audio-sync";
		rockchip,audio-ref = <&i2s_2ch_0 1>;
		rockchip,audio-tgt = <&i2s_8ch_0 0>;
	};

	audio_sync1: audio-sync1 {
		status = "disabled";
		compatible = "rockchip,audio-sync";
		rockchip,audio-ref = <&spdif_rx 1>;
		rockchip,audio-tgt = <&i2s_8ch_0 0>;
	};

	bluetooth_sound: bluetooth-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-bt";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&i2s_2ch_0>;
		rockchip,codec = <&bt_dummy_codec>;
		rockchip,format = "i2s";
		rockchip,wait-card-locked = <0>;

		//for extern-bt, we recommend to set i2s to slave for tws.
		rockchip,frame-master = <&bt_dummy_codec>;
		rockchip,bitclock-master = <&bt_dummy_codec>;
	};

	bt_dummy_codec: bt-dummy-codec {
		status = "okay";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;
	};

	mic_dummy_codec: mic-dummy-codec {
		status = "okay";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;

		//enable it when MCLK connected to mic codec.
		clocks = <&cru SCLK_I2S1_8CH_TX_OUT>;
		clock-names = "mclk";
	};

	mic_sound: mic-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-mic";
		rockchip,mclk-fs = <256>;
		rockchip,format = "i2s";
		rockchip,wait-card-locked = <1>;

		rockchip,cpu = <&i2s_8ch_1>;
		rockchip,codec = <&mic_dummy_codec>;
	};

	spdiftx_dummy_codec: spdiftx-dummy-codec {
		status = "disabled";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;
	};

	spdifrx_dummy_codec: spdif-rx-codec {
		status = "disabled";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;
	};

	spdif_tx_sound: spdif-tx-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,spdif-tx";
		rockchip,mclk-fs = <128>;
		rockchip,cpu = <&spdif_tx>;
		rockchip,codec = <&spdiftx_dummy_codec>;
	};

	spdif_rx_sound: spdif-rx-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,spdif-rx";
		rockchip,mclk-fs = <128>;
		rockchip,cpu = <&spdif_rx>;
		rockchip,codec = <&spdifrx_dummy_codec>;
	};

	vcc_3v3: vcc_io: vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_ddr: vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
	};

	vccio_flash: vccio-flash {
		compatible = "regulator-fixed";
		regulator-name = "vccio_flash";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vdd_core: vdd-core {
		compatible = "pwm-regulator";
		pwms = <&pwm0 0 5000 1>;
		regulator-name = "vdd_core";
		regulator-min-microvolt = <827000>;
		regulator-max-microvolt = <1340000>;
		regulator-init-microvolt = <1015000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		status = "okay";
	};

	vdd_log: vdd-log {
		compatible = "regulator-fixed";
		regulator-name = "vdd_log";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
	};

	vdd_1v0: vdd-1v0 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1000000>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_codec";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_io>;
	};

	vccio_sdio: vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_io>;
	};

	/*vbus_host: vbus-host-regulator {
	 *	compatible = "regulator-fixed";
	 *	enable-active-high;
	 *	gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
	 *	pinctrl-names = "default";
	 *	pinctrl-0 = <&usb_drv>;
	 *	regulator-name = "vbus_host";
	 *};
	 */
};

&acodec {
	status = "disabled";
	#sound-dai-cells = <0>;

	rockchip,no-hp-det;
	rockchip,no-deep-low-power;
	//rockchip,boot-dac-out = "line";
	//spk-ctl-gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
	//rockchip,en-always-grps = <1 2 3>;
	//rockchip,adc-grps-route = <1 2 3 0>;
};

&i2s_2ch_0 {
	status = "okay";
	#sound-dai-cells = <0>;
	#sound-stream-cells = <1>;
};

&i2s_8ch_0 {
	#sound-stream-cells = <1>;
	#sound-dai-cells = <0>;
	rockchip,clk-trcm = <1>;
	//rockchip,i2s-tx-route = <1 0 2 3>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_8ch_0_sclktx
		&i2s_8ch_0_lrcktx
		&i2s_8ch_0_sdi0
		&i2s_8ch_0_sdi1
		&i2s_8ch_0_sdi2
		&i2s_8ch_0_sdo0
		&i2s_8ch_0_sdo1
		&i2s_8ch_0_sdo2
		&i2s_8ch_0_mclk>;
	status = "okay";
};

&i2s_8ch_1 {
	status = "okay";
	#sound-dai-cells = <0>;
	rockchip,clk-trcm = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_8ch_1_m1_mclk
		&i2s_8ch_1_m1_sclktx
		&i2s_8ch_1_m1_lrcktx
		&i2s_8ch_1_m1_sdi0>;
};

&i2s_8ch_2 {
	status = "disabled";
	#sound-dai-cells = <0>;
};

&io_domains {
	status = "okay";

	vccio0-supply = <&vcc_io>;
	vccio1-supply = <&vcc_io>;
	vccio2-supply = <&vcc_io>;
	vccio3-supply = <&vcc_io>;
	vccio4-supply = <&vcc_io>;
	vccio5-supply = <&vcc_io>;
};

&cpu0 {
	cpu-supply = <&vdd_core>;
};

&cpu0_opp_table {
	opp-408000000 {
		status = "disabled";
	};
	opp-600000000 {
		status = "disabled";
	};
	opp-1200000000 {
		status = "okay";
	};
	opp-1296000000 {
		status = "okay";
	};
};

&rk3308bs_cpu0_opp_table {
	opp-408000000 {
		status = "disabled";
	};
	opp-600000000 {
		status = "disabled";
	};
	opp-1200000000 {
		status = "okay";
	};
	opp-1296000000 {
		status = "okay";
	};
};

&dmac0 {
	iram = <&vad_sram>;
};

&dmac1 {
	iram = <&vad_sram>;
};

&vad_sram {
	pool;
};

&dmc {
	center-supply = <&vdd_log>;
	status = "okay";
};

&fiq_debugger {
	status = "okay";
};

&nandc {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-names = "active";
	pinctrl-0 = <&pwm0_pin_pull_down>;
};

&rockchip_suspend {
	rockchip,pwm-regulator-config = <
		(0
		| RKPM_PWM_REGULATOR
		)
	>;

	status = "okay";
};

&rng {
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sfc {
	status = "okay";
};

&soc_thermal {
	trips {
		threshold: trip-point@0 {
			temperature = <80000>;
			hysteresis = <2000>;
			type = "passive";
		};
		target: trip-point@1 {
			temperature = <95000>;
			hysteresis = <2000>;
			type = "passive";
		};
		soc_crit: soc-crit {
			temperature = <115000>;
			hysteresis = <2000>;
			type = "critical";
		};
	};
};

&spdif_tx {
	#sound-dai-cells = <0>;
};

&spdif_rx {
	status = "disabled";
	#sound-stream-cells = <1>;
	#sound-dai-cells = <0>;
	rockchip,always-on;
	assigned-clocks = <&cru SCLK_SPDIF_RX>;
	assigned-clock-rates = <393216000>;
};

&tsadc {
	rockchip,hw-tshut-mode = <0>; /* tshut mode 0:CRU 1:GPIO */
	rockchip,hw-tshut-polarity = <1>; /* tshut polarity 0:LOW 1:HIGH */
	status = "okay";
};

&u2phy {
	status = "okay";
	u2phy_host: host-port {
		//phy-supply = <&vbus_host>;
		status = "okay";
	};

	u2phy_otg: otg-port {
		//vbus-supply = <&vbus_host>;
		status = "okay";
	};
};

&usb20_otg {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci{
	status = "okay";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_xfer>;
	dma-names = "!tx", "!rx";
	status = "okay";
};

&pinctrl {
	usb {
		usb_drv: usb-drv {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
